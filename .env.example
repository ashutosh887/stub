# Database. Two drivers, pick one.
#
# 1. Local Postgres (no AWS account needed): `docker compose up -d`, then set DATABASE_URL.
#    Transactions run at SERIALIZABLE, so you get the same 40001 conflicts and the same retry
#    path as production. When DATABASE_URL is set it wins and every DSQL_* var is ignored.
# DATABASE_URL=postgres://stub:stub@localhost:5432/stub
# DB_POOL_MAX=10
#
# 2. Aurora DSQL (production): leave DATABASE_URL unset and fill these in.
DSQL_ENDPOINT=your-cluster-id.dsql.us-east-1.on.aws
DSQL_REGION=us-east-1
DSQL_DATABASE=postgres
# Operator scripts (seed, bench, test:live) need admin. The app defaults to the least-privilege
# role stub_app when DSQL_USER is unset; migrate and db:app-role always connect as admin.
DSQL_USER=admin

# Production on Vercel: the IAM role from infra/stub-app-role.yaml. When set, the app signs DSQL
# tokens with short-lived credentials from Vercel OIDC instead of the default AWS credential chain.
# AWS_ROLE_ARN=arn:aws:iam::<account-id>:role/stub-app

# Connection pool. IMPORTANT on serverless (Vercel): set DSQL_POOL_MAX=1 because each
# function instance holds its own pool, so a high max multiplies connections.
# DSQL_POOL_MAX=5
# DSQL_PORT=5432
# DSQL_IDLE_TIMEOUT_MS=30000
# DSQL_CONNECTION_TIMEOUT_MS=10000
# DSQL_MAX_LIFETIME_SECONDS=600

# Peer Region endpoint of the multi-Region cluster. When set, the app fails over to it on its own:
# a connection the primary cannot open is retried on the peer at once, later calls stay on the
# peer, and after DSQL_FAILBACK_AFTER_MS a background probe returns them to the primary once it
# answers. DSQL_FAILOVER=off pins the app to DSQL_ENDPOINT. Also used by `npm run test:live` (which
# auto-skips without it) and `npm run drill:failover`.
# DSQL_ENDPOINT_PEER=your-peer-cluster-id.dsql.us-east-2.on.aws
# DSQL_REGION_PEER=us-east-2
# DSQL_FAILOVER=on
# DSQL_FAILBACK_AFTER_MS=60000
# DSQL_PROBE_TIMEOUT_MS=3000

# Natural-language query.
# Primary engine is OpenAI (set OPENAI_API_KEY). If it errors or is unset, the box falls back to a
# built-in deterministic parser automatically (free, offline). OPENAI_MODEL is optional.
OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini

# Admin auth. When ADMIN_TOKEN is set, the dashboard + mutating/data API routes require it
# (login at /api/auth, or Authorization: Bearer). When unset, routes are open in development and
# closed in production.
# ADMIN_TOKEN=choose-a-long-random-secret

# Operational tuning (all optional, sensible defaults shown).
# LOG_LEVEL=info                  # debug | info | warn | error
# MAX_SPEND_USD=1000000           # upper bound on a single spend
# MAX_RECEIPT_BYTES=64000         # cap on the x402 receipt JSON
# MAX_QUESTION_LENGTH=500         # NL query input cap
# OCC_MAX_RETRIES=25              # serialization-failure retries before 503
# RESERVATION_TTL_SECONDS=900     # a held reservation older than this is swept and released
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120              # per route per identity per window
# RATE_LIMIT_QUERY_MAX=20         # tighter limit for /api/query (OpenAI cost)

# Demo agent (`npm run demo:agent`). Points the SDK at a running Stub instance.
# STUB_BASE_URL=http://localhost:3000
# DEMO_SPENDS=12
# DEMO_PRICE_USD=0.40
