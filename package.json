{
  "name": "stub",
  "version": "1.0.0",
  "private": true,
  "description": "The general ledger for agent spend.",
  "homepage": "https://trystub.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashutosh887/stub.git"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "check:db": "tsx scripts/check-connection.ts",
    "migrate": "tsx scripts/migrate.ts",
    "db:app-role": "tsx scripts/app-role.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:activity": "tsx scripts/seed-activity.ts",
    "seed:drills": "tsx scripts/seed-drills.ts",
    "demo:agent": "tsx scripts/demo-agent.ts",
    "harness": "tsx scripts/harness.ts",
    "bench": "tsx scripts/bench.ts",
    "sweep": "tsx scripts/sweep.ts",
    "drill:failover": "tsx scripts/failover-drill.ts",
    "ledger:fingerprint": "tsx scripts/ledger-fingerprint.ts",
    "race:bypass": "tsx scripts/bypass-race.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm run test:invariant",
    "test": "vitest run test/invariant",
    "test:invariant": "vitest run test/invariant",
    "test:local": "vitest run test/local",
    "test:live": "vitest run test/live",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/dsql-signer": "^3.1178.0",
    "@vercel/oidc-aws-credentials-provider": "^3.3.22",
    "geist": "^1.9.2",
    "next": "^16.4.6",
    "openai": "^7.65.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
